name: Local CI-CD Pipeline
 
on:
  push:
    branches: [main]
 
jobs:
  deploy:
    runs-on: self-hosted
 
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
 
      - name: Docker Login
         run: echo "${{ secrets.DOCKERHUB_TOKEN }}" | docker login -u "${{ secrets.DOCKERHUB_USERNAME }}" --password-stdin
 
      - name: Build Docker Image
        run: |
          docker build -t vikranttiwari988/devops:${{ github.run_number }} .
          docker push vikranttiwari988/devops:${{ github.run_number }}
 
      - name: Terraform Init
        working-directory: terraform_pipeline/infra
        run: terraform init
 
      - name: Terraform Validate
        working-directory: terraform_pipeline/infra
        run: terraform validate
 
      - name: Terraform Plan
        working-directory: terraform_pipeline/infra
        run: terraform plan -var="image_tag=${{ github.run_number }}"
 
      - name: Terraform Apply
        working-directory: terraform_pipeline/infra
        run: terraform apply -auto-approve 
 
      - name: Wait for Deployment
        run: kubectl rollout status deployment/devops-app
 
      - name: Verify Pods
        run: kubectl get pods -o wide
